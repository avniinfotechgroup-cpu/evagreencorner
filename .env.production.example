# Production environment template for EVA Green Corner
# Copy to `.env` on the server (never commit real secrets).

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Public site URL (no trailing slash) — used for SEO, OAuth redirects, emails
VITE_APP_URL=https://evagreencorner.com
VITE_BRAND_NAME=EVA Green Corner
VITE_BRAND_TAGLINE=Your green corner for EV & clean living.
VITE_DEFAULT_COUNTRY=IN
VITE_DEFAULT_CITY=Bengaluru
VITE_SUPPORT_EMAIL=hello@evagreencorner.com

# Admin login (seeded on first DB open — change before go-live)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Open Charge Map — https://openchargemap.org/site/develop/api
OPEN_CHARGE_MAP_API_KEY=

# Email (pick Resend OR SMTP)
# RESEND_API_KEY=re_xxx
# RESEND_FROM="EVA Green Corner <hello@yourdomain.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=hello@yourdomain.com

# Optional OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Optional analytics fallbacks (or set in Admin → Analytics & scripts)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_GTM_CONTAINER_ID=GTM-XXXXXXX
