# Open Charge Map — free key from https://openchargemap.org/site/develop/api
OPEN_CHARGE_MAP_API_KEY=

# Brand
VITE_BRAND_NAME=EVA Green Corner
VITE_BRAND_TAGLINE=Your green corner for EV & clean living.
VITE_DEFAULT_COUNTRY=IN
VITE_DEFAULT_CITY=Bengaluru
VITE_SUPPORT_EMAIL=hello@evagreencorner.com
VITE_APP_URL=https://evagreencorner.com

# Optional analytics fallbacks (admin CMS overrides these when filled)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_GTM_CONTAINER_ID=GTM-XXXXXXX

# Admin panel (/admin) — seeded on first DB open
ADMIN_EMAIL=admin@evagreencorner.com
ADMIN_PASSWORD=Admin@123

# Email login credentials delivery (pick one)
# RESEND_API_KEY=re_xxx
# RESEND_FROM="EVA Green Corner <hello@evagreencorner.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=hello@evagreencorner.com

# Google OAuth (optional) — redirect URI: {VITE_APP_URL}/auth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (optional) — redirect URI: {VITE_APP_URL}/auth/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# Optional Python ranking service (see ml/README.md)
ML_RANKING_URL=http://127.0.0.1:8090
